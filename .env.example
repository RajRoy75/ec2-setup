# ==========================================
# Log-Agent Environment Configuration
# ==========================================

# Required: Target AWS S3 Bucket Name
S3_BUCKET=your-log-bucket-name

# Required: AWS Region (e.g., us-east-1, ap-south-1)
AWS_REGION=us-east-1

# Required: AWS Access Credentials
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Optional: S3 Key Prefix (default: logs/)
S3_PREFIX=logs/

# Optional: In-memory buffer size in MB before triggering S3 Parquet flush (default: 1)
BUFFER_SIZE_MB=1

# Optional: Maximum idle interval before safety flush if 1MB is not reached (default: 30m)
FLUSH_INTERVAL=30m

# Optional: Port on which the log-agent HTTP/WS server runs (default: 8081)
PORT=8081

# Optional: Override Instance ID (on EC2, this is automatically fetched via IMDSv2 or hostname)
# INSTANCE_ID=server-1

# Optional: List/Array of monitored machines for dashboard dropdown (JSON array)
SERVERS=[{"id":"local","name":"Localhost Dev","ip":"127.0.0.1","metrics_url":"http://localhost:8080","agent_url":"http://localhost:8081"},{"id":"ec2-prod","name":"EC2 Production (100.53.72.216)","ip":"100.53.72.216","metrics_url":"http://100.53.72.216:8091","agent_url":"http://100.53.72.216:8081"}]
